# ---------------------------------------------------------------------------
# ai-service — exemplo de configuração. Copie para .env e preencha.
# NUNCA commite o .env preenchido.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Autenticação service-to-service. Gere com: openssl rand -hex 32
# É o segredo que o TanStack Start envia no header x-ai-service-token.
SERVICE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# Conexão Postgres direta. Use uma role dedicada (ai_service), NÃO a service
# role do Supabase e NUNCA a publishable/anon key.
# Formato: postgresql://user:senha@host:5432/postgres
DATABASE_URL=

DB_POOL_MIN=1
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# LLM (LiteLLM)
# ---------------------------------------------------------------------------
# Nomes no formato LiteLLM: "<provider>/<modelo>".
LLM_FAST_MODEL=openai/gpt-4o-mini
LLM_SMART_MODEL=openai/gpt-4o
LLM_VISION_MODEL=openai/gpt-4o
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small

# Fallback por classe. Vazio = sem fallback.
LLM_FAST_FALLBACK=
LLM_SMART_FALLBACK=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Chaves dos providers (o LiteLLM lê direto do ambiente).
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings / RAG
# ---------------------------------------------------------------------------
# ATENÇÃO: a dimensão entra no DDL da coluna vector(N). Trocar depois exige
# migration + reindexação completa. text-embedding-3-small = 1536.
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64

RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40

# ---------------------------------------------------------------------------
# Observabilidade (Langfuse)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# ---------------------------------------------------------------------------
# Worker de agent_jobs
# ---------------------------------------------------------------------------
WORKER_ID=ai-service-local
WORKER_JOB_TYPES=python_sales_turn
WORKER_LOCK_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Modos e feature flags
# ---------------------------------------------------------------------------
# Default do serviço. Cada empresa pode sobrescrever (ver policies/execution.py).
# silent | assisted | automatic
DEFAULT_EXECUTION_MODE=silent

# Barreira FÍSICA de envio. Com false, nenhuma tool de escrita externa executa,
# independente de flag de empresa ou decisão do agente. Mantenha false até o
# shadow mode provar a nova arquitetura.
ALLOW_EXTERNAL_ACTIONS=false
