# Todas as variáveis são OBRIGATÓRIAS (as três primeiras). Nunca comitar valores reais.
# URL pública do Atende Aí (published deployment ou stable preview)
RENDER_API_URL=https://project--{project-id}.lovable.app
# Secret compartilhado entre Atende Aí e este worker (>= 32 chars, aleatório).
# O MESMO valor deve estar salvo em Secrets no Atende Aí como RENDER_WORKER_SECRET.
RENDER_WORKER_SECRET=
# Identificador legível (aparece em logs e em locked_by). Ex.: railway-render-01
WORKER_ID=render-worker-1

# Opcionais
POLL_INTERVAL_SECONDS=5
FFMPEG_TIMEOUT_SECONDS=300
HTTP_TIMEOUT_SECONDS=30
TMP_DIR=/tmp/render
LOG_LEVEL=info
