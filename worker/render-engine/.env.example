# Todas as variáveis são OBRIGATÓRIAS. Nunca comitar valores reais.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Identificador do worker (aparece em logs e em locked_by). Ex.: railway-render-01
WORKER_ID=render-worker-1
# Polling entre ciclos quando fila vazia (segundos)
POLL_INTERVAL_SECONDS=5
# Tempo de lock do job em segundos
LOCK_SECONDS=600
# Timeout máximo do processo FFmpeg em segundos
FFMPEG_TIMEOUT_SECONDS=300
# Diretório temporário (deve existir e ser writable)
TMP_DIR=/tmp/render
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
